---
import PlanLink from '@/components/PlanLink.astro';
---

<section id="contact" class="contact band-forest">
  <div class="wrap">
    <div class="contact-copy">
      <p class="eyebrow">When's your team adventure?</p>
      <h2 data-city-contact>Let's build a day your team will be quoting in six months.</h2>
      <p class="contact-sub">
        Start with your city, team size, and a date. Mike will help you choose the right format and plan the details.
      </p>

      <div class="contact-ctas">
        <PlanLink />
        <a href="tel:4054374597" class="btn phone-btn">
          <span aria-hidden="true">📞</span>
          (405) 437-4597
        </a>
      </div>

      <p class="contact-note">
        We read every email. The founder picks up the phone more often than not.
      </p>
    </div>
  </div>
</section>

<style>
  .contact {
    border-top: 3px solid var(--ink);
    padding-block: clamp(4rem, 8vw, 6rem);
    position: relative;
  }
  /* Elegant divider at the seam with the footer: a gold hairline that fades
     at both ends. */
  .contact::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: min(620px, 80%);
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in srgb, var(--gold) 70%, transparent) 50%,
      transparent
    );
  }

  .contact h2 {
    font-size: clamp(2rem, 1.5rem + 3vw, 3.5rem);
    line-height: 1;
    margin-bottom: 1.25rem;
    max-width: 18ch;
  }
  .contact-sub {
    font-size: 1.1rem;
    color: color-mix(in srgb, var(--paper) 80%, transparent);
    max-width: 46ch;
    margin-bottom: 2rem;
  }
  .contact-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .contact-ctas :global(.btn) {
    font-size: 1.05rem;
    padding: 1rem 1.6rem;
  }
  .contact-note {
    font-style: italic;
    color: color-mix(in srgb, var(--paper) 70%, transparent);
    font-size: 0.95rem;
  }
  .phone-btn {
    color: #000;
  }
  .phone-btn .arrow { color: #000; }

  @media (max-width: 820px) {
    .contact-copy { max-width: 100%; }
  }
</style>
