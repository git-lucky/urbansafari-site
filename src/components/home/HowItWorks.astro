---
import SafariIcon from '@/components/SafariIcon.astro';
const steps = [
  {
    n: '01',
    title: 'Tell us the brief',
    body: 'Date, team size, city, vibe. One 15-minute call and we\'ve got it.',
    icon: 'chat',
  },
  {
    n: '02',
    title: 'We build the expedition',
    body: 'Your custom game is ready to go when you are. No logistics on your plate.',
    icon: 'route',
  },
  {
    n: '03',
    title: 'Your team plays',
    body: 'Teams race through city challenges, photo missions, trivia, and creative tasks.',
    icon: 'team',
  },
  {
    n: '04',
    title: 'Everyone leaves grinning',
    body: 'Awards, a highlight reel, and a group photo that means something.',
    icon: 'celebrate',
  },
] as const;
---

<section id="how" class="section how">
  <div class="wrap">
    <header class="how-head">
      <p class="eyebrow">The expedition</p>
      <h2>Four steps. Sit back and enjoy the Safari.</h2>
    </header>

    <ol class="step-grid">
      {steps.map((step) => (
        <li class="step">
          <div class="step-icon"><SafariIcon name={step.icon} size={48} /></div>
          <p class="step-num">{step.n}</p>
          <h3>{step.title}</h3>
          <p class="step-body">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how-head {
    max-width: 900px;
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }
  .how-head .eyebrow { margin-bottom: 0.85rem; display: block; color: var(--forest-soft); }
  .how-head h2 { font-size: clamp(2rem, 4.4vw, 3.75rem); line-height: 1.05; max-width: 24ch; }

  .step-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    position: relative;
  }
  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    min-width: 0;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border: 3.5px solid #1B6B45;
    border-radius: 26px;
    background: linear-gradient(145deg, #FFFEFB, var(--paper) 60%, #F4F7F0);
    box-shadow: 7px 7px 0 0 #1B6B45, 0 16px 24px -12px rgb(31 58 43 / 28%), inset 0 1px 0 #FFFFFF;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .step-icon {
    width: 88px;
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(145deg, #F1F6EE, var(--forest-50) 55%, #DDE8DB);
    box-shadow: 3px 3px 0 0 #A9BEA9, inset 0 1px 0 rgb(255 255 255 / 90%);
    border: 2px solid #77987D;
    border-radius: 25px;
    color: #1B6B45;
    margin-bottom: 1.25rem;
    flex-shrink: 0;
  }
  .step-num {
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--forest-soft);
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    margin-bottom: 0.25rem;
  }
  .step h3 {
    font-size: var(--step-2);
    margin-bottom: 0.5rem;
    color: var(--ink);
  }
  .step-body {
    color: var(--forest-soft);
    font-size: 0.98rem;
    max-width: 45ch;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .step:hover {
      transform: translate(-3px, -3px);
      box-shadow: 10px 10px 0 0 #1B6B45, 0 22px 30px -14px rgb(31 58 43 / 30%), inset 0 1px 0 #FFFFFF;
    }
  }

  @media (max-width: 640px) {
    .step-grid { grid-template-columns: 1fr; }
  }
</style>
