---
import shots from '@/content/marketing-photos.json';
---
<section class="mosaic band-sand">
  <div class="wrap">
    <header class="mosaic-head">
      <p class="eyebrow">Real teams. Real moments.</p>
      <h2>Good things happen<br/>outside the meeting room.</h2>
      <p>Phone out. Team together. Everyone in on the next challenge.</p>
    </header>
    <div class="mosaic-grid">
      {shots.map(shot=>(
        <figure class="tile">
          <a href={shot.src} target="_blank" rel="noopener" aria-label={`Enlarge photo: ${shot.alt}`}>
            <img src={shot.src} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" decoding="async" />
          </a>
        </figure>
      ))}
    </div>
    <footer class="mosaic-footer">
      <p>We’ll keep adding photos from our latest scavenger hunts.</p>
      <p class="mosaic-credit">From our Woo Town Safari in Woodward, Oklahoma. Photos by Mike, Strunk, and our teams.</p>
    </footer>
  </div>
</section>
<style>
.mosaic{padding-block:clamp(3rem,7vw,6rem);border-block:2px solid var(--ink)}.mosaic-head{max-width:700px;margin-bottom:35px}.mosaic-head .eyebrow{margin-bottom:15px}.mosaic-head h2{font-size:clamp(34px,4.7vw,64px);overflow-wrap:break-word}.mosaic-head>p:last-child{margin-top:20px;color:var(--forest-soft)}.mosaic-grid{columns:3;column-gap:20px}.tile{break-inside:avoid;border:1px solid var(--forest-soft);border-radius:12px;overflow:hidden;background:var(--paper);margin-bottom:20px}.tile a{display:block}.tile img{display:block;width:100%;height:auto}.mosaic-footer{margin-top:28px;color:var(--forest-soft)}.mosaic-footer>p:first-child{font-size:1rem}.mosaic-credit{font-size:13px;margin-top:8px;color:var(--forest-soft)}@media(max-width:800px){.mosaic-grid{columns:2;column-gap:12px}.tile{margin-bottom:12px}.mosaic-credit{font-size:12px}}
</style>
