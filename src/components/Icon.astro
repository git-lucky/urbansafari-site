---
import { nextIconId } from './icon-ids';
// Filled icons from the Hybrid 04 design, rendered at build time.
// The wrapper keeps data-icon so the shared [data-icon] styles apply.
interface Props {
  name: 'camera' | 'film' | 'question' | 'list' | 'pen' | 'flag' | 'pin';
  class?: string;
}
const { name, class: className } = Astro.props;
const id = nextIconId(name);
const masked = (shape: string, cut: string) =>
  `<mask id="${id}"><rect width="24" height="24" fill="#fff"/>${cut}</mask><g mask="url(#${id})">${shape}</g>`;
const shapes: Record<Props['name'], () => string> = {
  camera: () => masked(`<path d="M9 3.5 7.6 5.6H4.2A2.2 2.2 0 0 0 2 7.8v10A2.2 2.2 0 0 0 4.2 20h15.6a2.2 2.2 0 0 0 2.2-2.2v-10a2.2 2.2 0 0 0-2.2-2.2h-3.4L15 3.5Z"/>`,
    `<circle cx="12" cy="12.6" r="4.4" fill="#000"/><circle cx="12" cy="12.6" r="2.4" fill="#fff"/>`),
  film: () => masked(`<rect x="3" y="10" width="18" height="11" rx="2"/><path d="m2.4 6.3 16.2-3.4a1 1 0 0 1 1.2.8l.6 2.9L2.9 10.2l-.6-2.8a1 1 0 0 1 .1-1.1Z"/>`,
    `<path d="m6 5.3 2.3 3.5M10.6 4.3l2.3 3.5M15.2 3.4l2.3 3.5" stroke="#000" stroke-width="1.6"/>`),
  question: () => masked(`<circle cx="12" cy="12" r="10"/>`,
    `<path d="M9.2 9.4a2.9 2.9 0 1 1 4 2.7c-.8.4-1.2.9-1.2 1.8v.5" fill="none" stroke="#000" stroke-width="2.3" stroke-linecap="round"/><circle cx="12" cy="17.4" r="1.4" fill="#000"/>`),
  list: () => `<circle cx="4.5" cy="6" r="2"/><circle cx="4.5" cy="12" r="2"/><circle cx="4.5" cy="18" r="2"/><rect x="9" y="4.8" width="13" height="2.6" rx="1.3"/><rect x="9" y="10.7" width="13" height="2.6" rx="1.3"/><rect x="9" y="16.7" width="13" height="2.6" rx="1.3"/>`,
  pen: () => `<path d="M16.6 3.3a2 2 0 0 1 2.8 0l1.3 1.3a2 2 0 0 1 0 2.8L9 19.1 3.6 20.4l1.3-5.4Z"/>`,
  flag: () => `<rect x="4.5" y="2.5" width="2.2" height="19" rx="1.1"/><path d="M8 4h12l-3 4.5 3 4.5H8Z"/>`,
  pin: () => masked(`<path d="M12 2a7 7 0 0 1 7 7c0 5.2-7 13-7 13S5 14.2 5 9a7 7 0 0 1 7-7Z"/>`, `<circle cx="12" cy="9" r="2.6" fill="#000"/>`),
};
const svg = `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">${shapes[name]()}</svg>`;
---
<span class={className} data-icon={name} set:html={svg} />
