---
import { nextIconId } from './icon-ids';
// Filled icons from the Hybrid 04 design, rendered at build time.
// The wrapper keeps data-icon so the shared [data-icon] styles apply.
interface Props {
  name: 'flag' | 'pin';
  class?: string;
}
const { name, class: className } = Astro.props;
const id = nextIconId(name);
const masked = (shape: string, cut: string) =>
  `<mask id="${id}"><rect width="24" height="24" fill="#fff"/>${cut}</mask><g mask="url(#${id})">${shape}</g>`;
const shapes: Record<Props['name'], () => string> = {
  flag: () => `<rect x="4.5" y="2.5" width="2.2" height="19" rx="1.1"/><path d="M8 4h12l-3 4.5 3 4.5H8Z"/>`,
  pin: () => masked(`<path d="M12 2a7 7 0 0 1 7 7c0 5.2-7 13-7 13S5 14.2 5 9a7 7 0 0 1 7-7Z"/>`, `<circle cx="12" cy="9" r="2.6" fill="#000"/>`),
};
const svg = `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">${shapes[name]()}</svg>`;
---
<span class={className} data-icon={name} set:html={svg} />
