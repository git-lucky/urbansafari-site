---
import { footerCityLinks } from '@/content/cities';

const year = new Date().getFullYear();
const reviews = [
  { name: 'Google', href: 'https://g.page/r/Cex4AH2x_-WFEAI/review', logo: '/review-logos/google-g.png', qr: '/google-review-qr.svg' },
  { name: 'Yelp', href: 'https://www.yelp.com/biz/urban-safari-oklahoma-city-2', logo: '/review-logos/yelp-favicon.svg', qr: '/yelp-review-qr.svg' },
];
---

<footer class="site-footer band-forest">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <div class="brand-row">
        <img src="/logo/atlas-coin-back.png" alt="" width="211" height="211" class="footer-coin" />
        <div>
          <p class="footer-wordmark">Urban&nbsp;Safari</p>
          <p class="footer-tag">
            City-wide expeditions that leave teams closer, louder,
            and happy they were invited.
          </p>
        </div>
      </div>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <div class="footer-contact">
        <p class="footer-head footer-head-lg">Get in touch</p>
        <ul>
          <li>
            <a href="tel:4054374597">
              <svg
                class="footer-icon"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
              <span>(405) 437-4597</span>
            </a>
          </li>
          <li>
            <a href="mailto:mike@urbansafari.app">
              <svg
                class="footer-icon"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m2 7 10 6 10-6" />
              </svg>
              <span>mike@urbansafari.app</span>
            </a>
          </li>
        </ul>
      </div>
      <details class="footer-locations footer-collapse">
        <summary class="footer-head">Featured cities</summary>
        <p class="footer-city-note">We can build a hunt in any city.</p>
        <ul class="city-links">
          {footerCityLinks.map((city) => (
            <li><a href={`/cities/${city.slug}/`}>{city.name}</a></li>
          ))}
          <li><a href="/cities/">All featured cities</a></li>
          <li><a href="/plan/">Plan in another city →</a></li>
        </ul>
      </details>
      <details class="footer-safari footer-collapse">
        <summary class="footer-head">Safari</summary>
        <ul>
          <li><a href="/#tiers">Experience tiers</a></li>
          <li><a href="/#how">How it works</a></li>
          <li><a href="/#outcomes">Outcomes</a></li>
          <li><a href="/#faq">FAQ</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/terms">Terms</a></li>
          <li><a href="/support">Support</a></li>
        </ul>
      </details>
    </nav>
  </div>

  <div class="wrap footer-review-row" aria-label="Review Urban Safari">
    {reviews.map(review => (
      <a class="footer-review" href={review.href} target="_blank" rel="noopener noreferrer">
        <img class="footer-review-qr" src={review.qr} alt={`Scan to open Urban Safari on ${review.name}`} width="88" height="88" loading="lazy" />
        <span class="footer-review-text">
          <img class="review-platform-logo" src={review.logo} alt="" width="28" height="28" loading="lazy" />
          <span class="footer-review-label">Review us on {review.name} <span aria-hidden="true">↗</span></span>
        </span>
      </a>
    ))}
  </div>

  <slot />

  <div class="wrap footer-legal">
    <span class="footer-copy">© {year} Urban Safari Game Experiences.</span>
    <span class="footer-motto">Made by a team that still high-fives after meetings.</span>
    <a
      class="powered-by"
      href="https://huntstack.tech"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="powered-by-label">Powered by</span>
      <img
        src="/huntstack-logo-lockup-transparent.png"
        alt="HuntStack"
        class="powered-by-lockup"
        width="1202"
        height="292"
      />
    </a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section);
    padding-block: clamp(3.5rem, 8vw, 5.5rem) 2.5rem;
    border-top: 3px solid var(--ink);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 2fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .brand-row {
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
  }
  .footer-wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    color: var(--paper);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .footer-tag {
    color: color-mix(in srgb, var(--paper) 80%, transparent);
    max-width: 34ch;
    font-size: 0.98rem;
  }

  .footer-review-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: 820px;
    margin-top: 2.75rem;
  }
  .footer-review {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--paper) 25%, transparent);
    border-radius: var(--radius-md);
  }
  .footer-review:focus-visible { outline: 3px solid var(--gold); outline-offset: 4px; }
  .footer-review:hover { border-color: var(--gold); }
  .footer-review-qr {
    width: 88px;
    height: 88px;
    flex-shrink: 0;
    border-radius: 8px;
    background: #fff;
  }
  .footer-review-text { display: grid; gap: 0.65rem; }
  .review-platform-logo { width: 28px; height: 28px; object-fit: contain; background: #fff; border-radius: 6px; padding: 3px; box-sizing: content-box; }
  .footer-review-label { font-size: 1rem; font-weight: 700; color: var(--paper); }
  .footer-review:hover .footer-review-label { color: var(--gold); }
  .footer-nav {
    display: grid;
    grid-template-columns: 1fr 1fr 1.5fr;
    grid-template-areas: "contact safari locations";
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .footer-head {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sunset);
    margin-bottom: 0.85rem;
  }
  .footer-head-lg {
    font-size: 0.92rem;
    margin-bottom: 1rem;
  }

  .footer-nav li {
    margin-bottom: 0.5rem;
  }
  .footer-nav a {
    color: color-mix(in srgb, var(--paper) 85%, transparent);
    transition: color 0.18s;
  }
  .footer-nav a:hover { color: var(--coral-soft); }

  .footer-contact { grid-area: contact; }
  .footer-safari { grid-area: safari; }
  .footer-locations { grid-area: locations; }
  .footer-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.02rem;
  }
  .footer-icon {
    flex-shrink: 0;
    color: var(--sunset);
  }

  .footer-locations .footer-head { margin-bottom: 1rem; }
  .footer-city-note { color: var(--paper); font-size: 0.9rem; margin-block: 1rem; max-width: 24ch; }

  /* Collapsible footer sections (Safari, Cities) */
  .footer-collapse summary.footer-head {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    width: fit-content;
    margin-bottom: 0;
    transition: color 0.18s ease;
  }
  .footer-collapse summary::-webkit-details-marker { display: none; }
  .footer-collapse summary::after {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    margin-top: -3px;
    transition: transform 0.18s ease;
  }
  .footer-collapse[open] summary::after { transform: rotate(-135deg); margin-top: 1px; }
  .footer-collapse summary:hover { color: var(--gold); }
  .footer-collapse[open] > ul { margin-top: 1rem; }

  .city-links {
    columns: 2;
    column-gap: 2rem;
  }
  .city-links li {
    break-inside: avoid;
    margin-bottom: 0.6rem;
  }

  .footer-legal {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem 1.5rem;
    padding-top: 2.5rem;
    margin-top: 2.5rem;
    border-top: 1px solid color-mix(in srgb, var(--paper) 20%, transparent);
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--paper) 70%, transparent);
  }
  .footer-copy { grid-column: 1; justify-self: start; }
  .footer-motto {
    grid-column: 3;
    justify-self: end;
    text-align: right;
    font-style: italic;
    font-family: var(--font-display);
  }

  .powered-by {
    grid-column: 2;
    justify-self: center;
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--paper) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--paper) 12%, transparent);
    transition: transform 0.18s ease, box-shadow 0.18s ease,
      border-color 0.18s ease, background 0.18s ease;
  }
  .powered-by-label {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: color-mix(in srgb, var(--paper) 55%, transparent);
    transition: color 0.18s ease;
  }
  .powered-by-lockup {
    height: 1.5rem;
    width: auto;
    display: block;
  }
  .powered-by:hover {
    transform: translateY(-1px);
    background: color-mix(in srgb, var(--paper) 12%, transparent);
    border-color: color-mix(in srgb, var(--paper) 24%, transparent);
    box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.45);
  }
  .powered-by:hover .powered-by-label {
    color: color-mix(in srgb, var(--paper) 85%, transparent);
  }

  .footer-coin { margin-top: -20px; }

  @media (max-width: 760px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-nav { grid-template-columns: 1fr; grid-template-areas: "contact" "locations" "safari"; gap: 1.75rem; }
    .footer-review-row { grid-template-columns: 1fr; max-width: 440px; }
    .footer-review-qr { width: 72px; height: 72px; }
    .footer-review { gap: 0.85rem; }
    .brand-row {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .footer-tag { margin-inline: auto; }
    .footer-coin { margin-top: -20px; }

    .footer-legal {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 1.25rem;
    }
    .footer-copy { grid-column: 1; justify-self: center; }
    .footer-motto {
      grid-column: 1;
      justify-self: center;
      text-align: center;
    }
    .powered-by { grid-column: 1; justify-self: center; }
  }
</style>
