  team: '<circle cx="9" cy="7" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 4a3 3 0 0 1 0 6M18 14a5 5 0 0 1 3 4v3"/>',
  celebrate: '<circle cx="12" cy="9" r="6"/><path d="m8 14-1 8 5-3 5 3-1-8M9.5 9l1.5 1.5 3.5-3.5"/>',
  smile: '<circle cx="12" cy="12" r="9"/><path d="M8 14a4.5 4.5 0 0 0 8 0M8 9h.01M16 9h.01"/>',
