---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
---
<Base title="Off the map" description="This page isn't on our route. Head back to base camp." noIndex>
  <section class="lost paper" aria-labelledby="lost-title">
    <div class="wrap page-hero page-hero-grid">
      <div>
        <p class="lost-code"><Icon name="pin" class="lost-pin" />Error 404</p>
        <h1 class="page-title" id="lost-title">This trail has no pin.</h1>
        <p class="page-lede">Atlas wandered off the map and couldn't find this page. Happens to the best of us.</p>
        <div class="page-actions">
          <a class="btn btn-gold btn-lg" href="/">Back to base camp</a>
          <a class="btn btn-quiet btn-lg" href="/support/#contact">Tell us what you were looking for</a>
        </div>
        <nav class="lost-trails" aria-label="Other pages">
          <p>Or pick up another trail:</p>
          <a href="/plan/">Plan an expedition</a>
          <a href="/cities/">Featured cities</a>
          <a href="/support/">Help and support</a>
        </nav>
      </div>
      <div class="page-art lost-art">
        <img src="/img/atlas-lost.webp" width="659" height="720" alt="Atlas the elephant sits on the ground, puzzling over a folded map." />
      </div>
    </div>
  </section>
</Base>
